// SPDX-License-Identifier: GPL-3.0-or-later
// OctoMX: Windows resources: application icon (16/32/48/256, drawn by
// mx::ui::iconImage(IconId::App); regenerate with `octomx --export-icons <dir>`) and version info.
// [post-1] a template: src/app/CMakeLists.txt fills in the @...@ values (the version from
// project(OctoMX VERSION ...) in the top-level CMakeLists.txt, the absolute resource paths).
#include <winver.h>

IDI_ICON1 ICON "@MX_RC_DIR@/octomx.ico"

// [ui-e] per-monitor DPI awareness (v2): see octomx.manifest
1 24 "@MX_RC_DIR@/octomx.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OctoMX project\0"
            VALUE "FileDescription",  "OctoMX\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0\0"
            VALUE "InternalName",     "octomx\0"
            VALUE "LegalCopyright",   "OctoMX contributors\0"
            VALUE "OriginalFilename", "octomx.exe\0"
            VALUE "ProductName",      "OctoMX\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
